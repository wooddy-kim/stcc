# Database
DATABASE_URL=postgresql://user:password@host:5432/stcc

# Cron API 보안 토큰 (필수: cron-job.org가 /api/cron/* 호출 시 Bearer 헤더로 전달)
CRON_SECRET=your-secure-random-token-here

# Admin
ADMIN_TOKEN=your-secure-token

# Google AdSense (Public)
PUBLIC_ADSENSE_CLIENT_ID=ca-pub-1234567890123456
# Optional: Mobile-specific ad slot ID (320x100 Large Mobile Banner)
# PUBLIC_ADSENSE_MOBILE_SLOT=1234567890

# Google Analytics 4 측정 ID (선택: 미설정 시 GA 스크립트를 렌더하지 않음)
PUBLIC_GA4_ID=G-XXXXXXXXXX

# 카카오맵 JavaScript API 키 (https://developers.kakao.com)
PUBLIC_KAKAO_MAP_KEY=c09fad8cb99996bdc84d925a529e3c5f

# YouTube Data API v3 (콘텐츠 자동 생성 시 영상 검색용, 선택)
YOUTUBE_API_KEY=your-youtube-api-key
